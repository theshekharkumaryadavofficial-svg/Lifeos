rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Entity validation helpers (Anti-Update-Gap)
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.tagline is string && data.tagline.size() <= 100 &&
             data.dailyGoalText is string && data.dailyGoalText.size() <= 120 &&
             data.level is int && data.level >= 1 && data.level <= 999 &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
             data.totalStudyMinutes is int && data.totalStudyMinutes >= 0 && data.totalStudyMinutes <= 10000000 &&
             data.totalNaamJapCount is int && data.totalNaamJapCount >= 0 && data.totalNaamJapCount <= 100000000 &&
             data.todayNaamJapCount is int && data.todayNaamJapCount >= 0 && data.todayNaamJapCount <= 1000000 &&
             data.todayMalas is int && data.todayMalas >= 0 && data.todayMalas <= 10000 &&
             data.activeMantra is string && data.activeMantra.size() >= 1 && data.activeMantra.size() <= 60 &&
             data.todayWaterGlasses is int && data.todayWaterGlasses >= 0 && data.todayWaterGlasses <= 50 &&
             (data.todaySleepHours is int || data.todaySleepHours is float) && data.todaySleepHours >= 0 && data.todaySleepHours <= 24 &&
             data.motivationMode is bool &&
             data.lastActiveDate is string && data.lastActiveDate.size() <= 20 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLifeTask(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.category is string && data.category in ['STUDY', 'FITNESS', 'DISCIPLINE', 'WORK'] &&
             data.completed is bool &&
             data.dueDate is string && data.dueDate.size() <= 30 &&
             data.priority is string && data.priority in ['HIGH', 'MEDIUM', 'LOW'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudySubject(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100 &&
             data.studyMinutes is int && data.studyMinutes >= 0 && data.studyMinutes <= 1000000 &&
             data.accentKey is string && data.accentKey in ['CRIMSON', 'GOLD', 'CYAN', 'PURPLE', 'GREEN'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudyNote(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.subjectName is string && data.subjectName.size() <= 80 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 8000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWorkoutLog(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.activityType is string && data.activityType in ['RUNNING', 'WALKING', 'WORKOUT', 'YOGA', 'CYCLING'] &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
             (data.distanceKm is int || data.distanceKm is float) && data.distanceKm >= 0 && data.distanceKm <= 500 &&
             data.caloriesBurned is int && data.caloriesBurned >= 0 && data.caloriesBurned <= 10000 &&
             data.dateLabel is string && data.dateLabel.size() <= 30 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSadhanaLog(data, userId) {
      return data.userId == userId &&
             data.mantra is string && data.mantra.size() >= 1 && data.mantra.size() <= 60 &&
             data.count is int && data.count >= 1 && data.count <= 100000 &&
             data.malas is int && data.malas >= 0 && data.malas <= 1000 &&
             data.meditationMinutes is int && data.meditationMinutes >= 0 && data.meditationMinutes <= 600 &&
             data.dateLabel is string && data.dateLabel.size() <= 30 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 1. User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'tagline', 'dailyGoalText',
                         'level', 'xp', 'streakDays', 'totalStudyMinutes',
                         'totalNaamJapCount', 'todayNaamJapCount', 'todayMalas',
                         'activeMantra', 'todayWaterGlasses', 'todaySleepHours',
                         'motivationMode', 'lastActiveDate', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'tagline', 'dailyGoalText',
                         'level', 'xp', 'streakDays', 'totalStudyMinutes',
                         'totalNaamJapCount', 'todayNaamJapCount', 'todayMalas',
                         'activeMantra', 'todayWaterGlasses', 'todaySleepHours',
                         'motivationMode', 'lastActiveDate', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'tagline', 'dailyGoalText', 'level', 'xp',
                         'streakDays', 'totalStudyMinutes', 'totalNaamJapCount',
                         'todayNaamJapCount', 'todayMalas', 'activeMantra',
                         'todayWaterGlasses', 'todaySleepHours', 'motivationMode',
                         'lastActiveDate', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'category', 'completed',
                           'dueDate', 'priority', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'category', 'completed',
                           'dueDate', 'priority', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLifeTask(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidLifeTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'completed', 'dueDate', 'priority', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // 3. Study Subjects Subcollection
      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'progressPercent', 'studyMinutes',
                           'accentKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'progressPercent', 'studyMinutes',
                           'accentKey', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidStudySubject(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         isValidStudySubject(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'progressPercent', 'studyMinutes', 'accentKey', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      // 4. Study Notes Subcollection
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'subjectName', 'content',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'subjectName', 'content',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidStudyNote(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidStudyNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subjectName', 'content', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // 5. Workouts Subcollection
      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(workoutId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(workoutId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'activityType', 'durationMinutes',
                           'distanceKm', 'caloriesBurned', 'dateLabel',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'activityType', 'durationMinutes',
                           'distanceKm', 'caloriesBurned', 'dateLabel',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidWorkoutLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(workoutId) &&
                         isValidWorkoutLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'activityType', 'durationMinutes', 'distanceKm',
                           'caloriesBurned', 'dateLabel', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // 6. Sadhana / Naam Jap Logs Subcollection
      match /sadhanaLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'mantra', 'count', 'malas',
                           'meditationMinutes', 'dateLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'mantra', 'count', 'malas',
                           'meditationMinutes', 'dateLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidSadhanaLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidSadhanaLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'mantra', 'count', 'malas', 'meditationMinutes', 'dateLabel', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
